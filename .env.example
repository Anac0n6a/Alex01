# База песочницы (SQLite, создаётся командой npm run setup)
DATABASE_URL="file:./dev.db"

PORT=3000

# Ключ основного провайдера (GPTunneL). Выдаётся на встрече.
GPTUNNEL_BASE_URL="https://gptunnel.ru/v1"
GPTUNNEL_API_KEY=""

# Токен для /admin/* и кабинета
ADMIN_TOKEN="dev-admin"

# Деградация провайдеров для воспроизведения инцидентов (0 = выключено)
# Задержка перед первым токеном основного провайдера, мс
CHAOS_FIRST_TOKEN_DELAY_MS=0
# Доля стримов основного провайдера, которые рвутся посередине (0..1)
CHAOS_MIDSTREAM_FAIL_RATE=0
# Через сколько чанков рвётся стрим
CHAOS_MIDSTREAM_FAIL_AFTER_CHUNKS=5
# Доля запросов к резервному провайдеру, которые сразу получают 429 (0..1)
CHAOS_RESERVE_FAIL_RATE=0
